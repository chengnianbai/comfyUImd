# ---- 本地工具与会话产物（不属项目内容，仅留在本机）----
.workbuddy/
.commandcode/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 日志与临时文件 ----
*.log
*.tmp
~$*

# ---- 操作系统垃圾 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 误创建的垃圾文件（文件名以 [ 开头，如 _scripts/['1020'）----
_scripts/[[]*

# ---- 本地清理暂存（体积大、非项目内容，确认后可删）----
_trash/
